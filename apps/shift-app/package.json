{
  "name": "shift-app",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@expo-google-fonts/instrument-sans": "^0.4.2",
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@types/jest": "^30.0.0",
    "expo": "~58.0.25",
    "expo-build-properties": "~58.0.12",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-intent-launcher": "~58.0.3",
    "expo-linear-gradient": "~58.0.4",
    "expo-notifications": "~58.1.9",
    "expo-sharing": "~58.0.23",
    "expo-status-bar": "~58.0.5",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-android-widget": "^0.26.0",
    "react-native-google-mobile-ads": "^17.4.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/",
      "/android/",
      "/ios/"
    ]
  },
  "expo": {
    "autolinking": {
      "ios": {
        "exclude": [
          "react-native-google-mobile-ads"
        ]
      }
    }
  }
